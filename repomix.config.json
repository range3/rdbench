{
  "output": {
    "filePath": "rdbench-repomix-output.md",
    "style": "markdown",
    "fileSummary": true,
    "directoryStructure": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "topFilesLength": 5,
    "showLineNumbers": false,
    "copyToClipboard": false
  },
  "include": [
    "source/**/*.{cpp,hpp}",
    "CMakePresets.json",
    "**/CMakeLists.txt",
    "cmake/**/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "source/cxxraii/**/*",
      "source/prof/**/*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
